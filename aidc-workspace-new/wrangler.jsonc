{
  "name": "sunjin-aidc-workspace-demo",
  "account_id": "f1ac689fded81b2578beca600e38fea6",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "main": "shared-worker.mjs",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Workspace",
        "name": "WORKSPACE"
      }
    ]
  },
  "migrations": [
    {
      "tag": "shared-v1",
      "new_sqlite_classes": [
        "Workspace"
      ]
    }
  ],
  "rules": [
    {
      "globs": [
        "**/seed.json"
      ],
      "type": "Text",
      "fallthrough": true
    }
  ]
}
